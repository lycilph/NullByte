<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- existing properties -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- not every public member is documented -->
  </PropertyGroup>
  
  <ItemGroup>
    <None Remove="Data\activities.json" />
    <None Remove="Data\initial-network.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\activities.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\initial-network.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
	  <InternalsVisibleTo Include="NullByte.Core.Tests" />
	  <InternalsVisibleTo Include="NullByte.ConsoleUI.Tests" />
  </ItemGroup>
</Project>
