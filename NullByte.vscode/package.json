{
  "name": "nullbyte",
  "displayName": "NullByte",
  "description": "Browse and edit the NullByte virtual filesystem from Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "LyCilph",
  "engines": { "vscode": "^1.90.0" },
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": { "supported": true }
  },
  "activationEvents": [ "onFileSystem:nullbyte" ],
  "contributes": {
    "commands": [
      { "command": "nullbyte.openWorkspace", "title": "Open Game Workspace", "category": "NullByte" },
      { "command": "nullbyte.showLog", "title": "Show Log", "category": "NullByte" },
      { "command": "nullbyte.reconnect", "title": "Reconnect", "category": "NullByte" }
    ],
     "configuration": {
      "title": "NullByte",
      "properties": {
        "nullbyte.connectionFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the connection file the game writes when started with `--vscode`. Leave empty for `~/.nullbyte/editor.json`. Use it together with the game's `--vscode-file` option."
        }
      }
    },
    "languages": [{
      "id": "nullbyte-script",
      "aliases": ["NullByte Script"],
      "extensions": [".cx"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nullbyte-script",
      "scopeName": "source.nullbyte-script",
      "path": "./syntaxes/nullbyte-script.tmLanguage.json"
    }]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.90",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
