{
  "name": "nullbyte",
  "displayName": "NullByte",
  "version": "0.3.0",
  "description": "Edit NullByte game scripts in VS Code: server folders and files, diagnostics, completion, hover and signature help.",
  "publisher": "LyCilph",
  "repository": {
    "type": "git",
    "url": "https://github.com/lycilph/NullByte.git",
    "directory": "NullByte.vscode"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "nullbyte",
    "game",
    "scripting",
    "csharp"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onFileSystem:nullbyte"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "nullbyte.openWorkspace",
        "title": "Open Game Workspace",
        "category": "NullByte"
      },
      {
        "command": "nullbyte.showLog",
        "title": "Show Log",
        "category": "NullByte"
      },
      {
        "command": "nullbyte.reconnect",
        "title": "Reconnect",
        "category": "NullByte"
      },
      {
        "command": "nullbyte.runCurrentFile",
        "title": "NullByte: Run Current File"
      }
    ],
    "keybindings": [
      {
        "command": "nullbyte.runCurrentFile",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorTextFocus && editorLangId == 'nullbyte-script'"
      }
    ],
    "configuration": {
      "title": "NullByte",
      "properties": {
        "nullbyte.connectionFile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the connection file the game writes when started with `--vscode`. Leave empty for `~/.nullbyte/editor.json`. Use it together with the game's `--vscode-file` option."
        }
      }
    },
    "languages": [
      {
        "id": "nullbyte-script",
        "aliases": [
          "NullByte Script"
        ],
        "extensions": [
          ".cx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nullbyte-script",
        "scopeName": "source.nullbyte-script",
        "path": "./syntaxes/nullbyte-script.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.90",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.1.1": true
  }
}
